{
  "name": "ai2nao-desktop",
  "productName": "ai2nao",
  "version": "0.4.0",
  "private": true,
  "description": "ai2nao 桌面应用 —— Electron 壳 + 内嵌 daemon",
  "type": "module",
  "main": "out/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node build.mjs",
    "start": "npm run build && electron out/main.js",
    "package": "npm run build && electron-builder --dir",
    "test:e2e": "playwright test",
    "icons": "node build/render-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.52",
    "@lancedb/lancedb": "^0.27.2",
    "apache-arrow": "^18.1.0",
    "better-sqlite3": "^13.0.2",
    "playwright": "^1.59.1",
    "pyodide": "^0.29.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.10.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.xunull.ai2nao",
    "productName": "ai2nao",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": "arm64"
        }
      ],
      "identity": null
    }
  }
}
